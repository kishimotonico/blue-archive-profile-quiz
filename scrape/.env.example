# このファイルを .env にコピーして値を設定してください（.env は git 管理外）

# 立ち絵のアップロード先 R2 bucket 名
R2_BUCKET=
# bucket 内のキーの接頭辞。画像は <R2_IMAGE_PREFIX>/<student_id>.png に置かれる（省略時 portrait）
R2_IMAGE_PREFIX=portrait

# Cloudflare の account ID
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare Dashboard のユーザー設定で作る API Token。権限は account scope の「Workers R2 Storage: Edit」
# R2 の「Manage API tokens」で作る S3 API 用のキーではないので注意
CLOUDFLARE_API_TOKEN=
